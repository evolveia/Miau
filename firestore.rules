rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isValidStats(stats) {
      return stats is map
        && stats.keys().hasAll(['hunger', 'hygiene', 'fun', 'sleep'])
        && stats.keys().hasOnly(['hunger', 'hygiene', 'fun', 'sleep', 'happiness'])
        && stats.hunger is number && stats.hunger >= 0 && stats.hunger <= 100
        && stats.hygiene is number && stats.hygiene >= 0 && stats.hygiene <= 100
        && stats.fun is number && stats.fun >= 0 && stats.fun <= 100
        && stats.sleep is number && stats.sleep >= 0 && stats.sleep <= 100
        && (!('happiness' in stats) || (stats.happiness is number && stats.happiness >= 0 && stats.happiness <= 100));
    }

    function isValidEquipped(equipped) {
      return equipped is map
        && equipped.keys().hasAll(['hat', 'accessory', 'background'])
        && equipped.keys().hasOnly(['hat', 'accessory', 'background'])
        && equipped.hat is string && equipped.hat.size() <= 64
        && equipped.accessory is string && equipped.accessory.size() <= 64
        && equipped.background is string && equipped.background.size() <= 64;
    }

    function isValidProgress(p) {
      return p is map
        && p.keys().hasAll(['mealsFed', 'gamesPlayed', 'cleanCount', 'petsCount', 'chatsCount'])
        && p.keys().hasOnly(['mealsFed', 'gamesPlayed', 'cleanCount', 'petsCount', 'chatsCount'])
        && p.mealsFed is int && p.mealsFed >= 0 && p.mealsFed <= 1000000
        && p.gamesPlayed is int && p.gamesPlayed >= 0 && p.gamesPlayed <= 1000000
        && p.cleanCount is int && p.cleanCount >= 0 && p.cleanCount <= 1000000
        && p.petsCount is int && p.petsCount >= 0 && p.petsCount <= 1000000
        && p.chatsCount is int && p.chatsCount >= 0 && p.chatsCount <= 1000000;
    }

    function isValidGameStat(r) {
      return r is map
        && r.keys().hasAll(['highScore', 'maxStage', 'bestTimeSec', 'totalCoins', 'plays'])
        && r.keys().hasOnly(['highScore', 'maxStage', 'bestTimeSec', 'totalCoins', 'plays'])
        && r.highScore is int && r.highScore >= 0 && r.highScore <= 10000000
        && r.maxStage is int && r.maxStage >= 1 && r.maxStage <= 999
        && r.bestTimeSec is int && r.bestTimeSec >= 0 && r.bestTimeSec <= 86400
        && r.totalCoins is int && r.totalCoins >= 0 && r.totalCoins <= 10000000
        && r.plays is int && r.plays >= 0 && r.plays <= 1000000;
    }

    function isValidGameRecords(gr) {
      return gr is map
        && gr.keys().hasOnly(['fish', 'memory', 'escape', 'galaxy', 'pacmiau', 'maze'])
        && (!('fish' in gr) || isValidGameStat(gr.fish))
        && (!('memory' in gr) || isValidGameStat(gr.memory))
        && (!('escape' in gr) || isValidGameStat(gr.escape))
        && (!('galaxy' in gr) || isValidGameStat(gr.galaxy))
        && (!('pacmiau' in gr) || isValidGameStat(gr.pacmiau))
        && (!('maze' in gr) || isValidGameStat(gr.maze));
    }

    function isValidDailyRoutine(dr) {
      return dr is map
        && dr.keys().hasAll(['dateKey', 'completedSlots'])
        && dr.keys().hasOnly(['dateKey', 'completedSlots'])
        && dr.dateKey is string && dr.dateKey.size() == 10 && dr.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && dr.completedSlots is list && dr.completedSlots.size() <= 20
        && (dr.completedSlots.size() == 0 || (dr.completedSlots[0] is string && dr.completedSlots[0].size() <= 40));
    }

    function isValidUserPetProfile(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'petName', 'coins', 'level', 'xp',
          'stats', 'equipped', 'ownedItems', 'soundEnabled',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'petName', 'coins', 'level', 'xp',
          'stats', 'equipped', 'ownedItems', 'soundEnabled',
          'unlockedAchievements', 'progress', 'gameRecords', 'dailyRoutine',
          'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId.size() <= 128 && data.ownerId == userId && data.ownerId == request.auth.uid
        && data.petName is string && data.petName.size() >= 1 && data.petName.size() <= 32
        && data.coins is int && data.coins >= 0 && data.coins <= 10000000
        && data.level is int && data.level >= 1 && data.level <= 999
        && data.xp is int && data.xp >= 0 && data.xp <= 100000
        && isValidStats(data.stats)
        && isValidEquipped(data.equipped)
        && data.ownedItems is list && data.ownedItems.size() >= 1 && data.ownedItems.size() <= 50 && data.ownedItems[0] is string && data.ownedItems[0].size() <= 64
        && data.soundEnabled is bool
        && (!('unlockedAchievements' in data) || (data.unlockedAchievements is list && data.unlockedAchievements.size() <= 50 && (data.unlockedAchievements.size() == 0 || (data.unlockedAchievements[0] is string && data.unlockedAchievements[0].size() <= 64))))
        && (!('progress' in data) || isValidProgress(data.progress))
        && (!('gameRecords' in data) || isValidGameRecords(data.gameRecords))
        && (!('dailyRoutine' in data) || isValidDailyRoutine(data.dailyRoutine))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPrivateInfo(data, userId) {
      return data.keys().hasAll(['ownerId', 'displayName', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'displayName', 'email', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId.size() <= 128 && data.ownerId == userId && data.ownerId == request.auth.uid
        && data.displayName is string && data.displayName.size() <= 80
        && data.email is string && data.email.size() <= 160
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserHumanProfile(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'fullName', 'birthDate', 'schooling',
          'state', 'country', 'photoDataUrl', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'fullName', 'birthDate', 'schooling',
          'state', 'country', 'photoDataUrl', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId.size() <= 128 && data.ownerId == userId && data.ownerId == request.auth.uid
        && data.fullName is string && data.fullName.size() <= 100
        && data.birthDate is string && data.birthDate.size() <= 10
        && (data.birthDate == '' || data.birthDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && data.schooling is string && data.schooling.size() <= 32
        && data.schooling in ['', 'educacao_infantil', 'fundamental_1', 'fundamental_2', 'medio', 'superior_outro']
        && data.state is string && data.state.size() <= 60
        && data.country is string && data.country.size() <= 60
        && data.photoDataUrl is string && data.photoDataUrl.size() <= 180000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidChatMessage(data, userId) {
      return data.keys().hasAll(['ownerId', 'sender', 'meowPrefix', 'text', 'mood', 'createdAt'])
        && data.keys().hasOnly(['ownerId', 'sender', 'meowPrefix', 'text', 'mood', 'createdAt'])
        && data.ownerId is string && data.ownerId.size() <= 128 && data.ownerId == userId && data.ownerId == request.auth.uid
        && data.sender is string && data.sender.size() <= 16 && data.sender in ['user', 'miau']
        && data.meowPrefix is string && data.meowPrefix.size() <= 40
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 1000
        && data.mood is string && data.mood.size() >= 1 && data.mood.size() <= 32
        && data.createdAt is timestamp;
    }

    function isValidGameScoreMap(m) {
      return m is map
        && m.keys().hasOnly(['fish', 'memory', 'escape', 'galaxy', 'pacmiau', 'maze'])
        && (!('fish' in m) || (m.fish is int && m.fish >= 0 && m.fish <= 10000000))
        && (!('memory' in m) || (m.memory is int && m.memory >= 0 && m.memory <= 10000000))
        && (!('escape' in m) || (m.escape is int && m.escape >= 0 && m.escape <= 10000000))
        && (!('galaxy' in m) || (m.galaxy is int && m.galaxy >= 0 && m.galaxy <= 10000000))
        && (!('pacmiau' in m) || (m.pacmiau is int && m.pacmiau >= 0 && m.pacmiau <= 10000000))
        && (!('maze' in m) || (m.maze is int && m.maze >= 0 && m.maze <= 10000000));
    }

    function isValidGameStageMap(m) {
      return m is map
        && m.keys().hasOnly(['fish', 'memory', 'escape', 'galaxy', 'pacmiau', 'maze'])
        && (!('fish' in m) || (m.fish is int && m.fish >= 1 && m.fish <= 999))
        && (!('memory' in m) || (m.memory is int && m.memory >= 1 && m.memory <= 999))
        && (!('escape' in m) || (m.escape is int && m.escape >= 1 && m.escape <= 999))
        && (!('galaxy' in m) || (m.galaxy is int && m.galaxy >= 1 && m.galaxy <= 999))
        && (!('pacmiau' in m) || (m.pacmiau is int && m.pacmiau >= 1 && m.pacmiau <= 999))
        && (!('maze' in m) || (m.maze is int && m.maze >= 1 && m.maze <= 999));
    }

    function isValidRankingEntry(data, userId) {
      return data.keys().hasAll(['ownerId', 'playerName', 'petName', 'totalScore', 'bestStage', 'coinsEarned', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'playerName', 'petName', 'totalScore', 'bestStage', 'coinsEarned', 'gameScores', 'gameStages', 'updatedAt'])
        && data.ownerId is string && data.ownerId.size() <= 128 && data.ownerId == userId && data.ownerId == request.auth.uid
        && data.playerName is string && data.playerName.size() >= 1 && data.playerName.size() <= 40
        && data.petName is string && data.petName.size() >= 1 && data.petName.size() <= 32
        && data.totalScore is int && data.totalScore >= 0 && data.totalScore <= 50000000
        && data.bestStage is int && data.bestStage >= 1 && data.bestStage <= 999
        && data.coinsEarned is int && data.coinsEarned >= 0 && data.coinsEarned <= 50000000
        && (!('gameScores' in data) || isValidGameScoreMap(data.gameScores))
        && (!('gameStages' in data) || isValidGameStageMap(data.gameStages))
        && data.updatedAt is timestamp;
    }

    function isValidEducationTrackId(trackId) {
      return trackId is string
        && trackId.size() >= 1
        && trackId.size() <= 48
        && trackId in [
          'infantil_letras',
          'infantil_escrita',
          'infantil_escrita_consoantes',
          'infantil_consoantes',
          'infantil_cores_numeros',
          'infantil_soma_subtracao',
          'infantil_matematica_desafios',
          'infantil_natureza',
          'infantil_comidas_bebidas',
          'fund1_leitura',
          'fund1_matematica',
          'fund1_ciencias',
          'fund2_logica',
          'fund2_ciencias',
          'fund2_historia'
        ];
    }

    function isValidEducationTrackProgress(data, userId, trackId) {
      return data.keys().hasAll([
          'ownerId', 'trackId', 'completedUnits', 'unitBestStars', 'letterBestStars',
          'totalStars', 'streakDays', 'bestStreakDays', 'lastStudyDateKey',
          'masteredPrimary', 'masteredTargets', 'unlockedStickers',
          'freeExploreUnlocked', 'totalLessonsCompleted', 'dailyDateKey',
          'dailyStepsCount', 'dailyCompletedTargets', 'dailyBonusClaimedDateKey',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'trackId', 'completedUnits', 'unitBestStars', 'letterBestStars',
          'totalStars', 'streakDays', 'bestStreakDays', 'lastStudyDateKey',
          'masteredPrimary', 'masteredTargets', 'unlockedStickers',
          'freeExploreUnlocked', 'totalLessonsCompleted', 'dailyDateKey',
          'dailyStepsCount', 'dailyCompletedTargets', 'dailyBonusClaimedDateKey',
          'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId.size() <= 128 && data.ownerId == userId && data.ownerId == request.auth.uid
        && isValidEducationTrackId(data.trackId) && data.trackId == trackId
        && data.completedUnits is list && data.completedUnits.size() <= 30
        && (data.completedUnits.size() == 0 || (data.completedUnits[0] is string && data.completedUnits[0].size() <= 48))
        && data.unitBestStars is map && data.unitBestStars.size() <= 30
        && data.letterBestStars is map && data.letterBestStars.size() <= 60
        && data.totalStars is int && data.totalStars >= 0 && data.totalStars <= 500
        && data.streakDays is int && data.streakDays >= 0 && data.streakDays <= 10000
        && data.bestStreakDays is int && data.bestStreakDays >= 0 && data.bestStreakDays <= 10000
        && data.lastStudyDateKey is string && data.lastStudyDateKey.size() <= 10
        && (data.lastStudyDateKey == '' || data.lastStudyDateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && data.masteredPrimary is list && data.masteredPrimary.size() <= 40
        && (data.masteredPrimary.size() == 0 || (data.masteredPrimary[0] is string && data.masteredPrimary[0].size() <= 48))
        && data.masteredTargets is list && data.masteredTargets.size() <= 150
        && (data.masteredTargets.size() == 0 || (data.masteredTargets[0] is string && data.masteredTargets[0].size() <= 48))
        && data.unlockedStickers is list && data.unlockedStickers.size() <= 60
        && (data.unlockedStickers.size() == 0 || (data.unlockedStickers[0] is string && data.unlockedStickers[0].size() <= 64))
        && data.freeExploreUnlocked is bool
        && data.totalLessonsCompleted is int && data.totalLessonsCompleted >= 0 && data.totalLessonsCompleted <= 1000000
        && data.dailyDateKey is string && data.dailyDateKey.size() <= 10
        && (data.dailyDateKey == '' || data.dailyDateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && data.dailyStepsCount is int && data.dailyStepsCount >= 0 && data.dailyStepsCount <= 1000
        && data.dailyCompletedTargets is list && data.dailyCompletedTargets.size() <= 60
        && (data.dailyCompletedTargets.size() == 0 || (data.dailyCompletedTargets[0] is string && data.dailyCompletedTargets[0].size() <= 32))
        && data.dailyBonusClaimedDateKey is string && data.dailyBonusClaimedDateKey.size() <= 10
        && (data.dailyBonusClaimedDateKey == '' || data.dailyBonusClaimedDateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDailyCoinEconomy(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'dateKey', 'petCoinsToday', 'lastPetCoinAtMs',
          'ballCoinsToday', 'lastBallCoinAtMs', 'minigameCoinsToday',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'dateKey', 'petCoinsToday', 'lastPetCoinAtMs',
          'ballCoinsToday', 'lastBallCoinAtMs', 'minigameCoinsToday',
          'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId.size() <= 128 && data.ownerId == userId && data.ownerId == request.auth.uid
        && data.dateKey is string && data.dateKey.size() == 10 && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.petCoinsToday is int && data.petCoinsToday >= 0 && data.petCoinsToday <= 500
        && data.lastPetCoinAtMs is int && data.lastPetCoinAtMs >= 0 && data.lastPetCoinAtMs <= 9999999999999
        && data.ballCoinsToday is int && data.ballCoinsToday >= 0 && data.ballCoinsToday <= 500
        && data.lastBallCoinAtMs is int && data.lastBallCoinAtMs >= 0 && data.lastBallCoinAtMs <= 9999999999999
        && data.minigameCoinsToday is int && data.minigameCoinsToday >= 0 && data.minigameCoinsToday <= 2000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidParentalConfig(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'pinHash', 'dailyScreenLimitMin', 'quietHoursEnabled',
          'quietStart', 'quietEnd', 'strictAiFilter', 'dailyMinutesByDate',
          'dailyLessonsByDate', 'screenLockBypassDateKey',
          'screenLockBypassUntilMs', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'pinHash', 'dailyScreenLimitMin', 'quietHoursEnabled',
          'quietStart', 'quietEnd', 'strictAiFilter', 'dailyMinutesByDate',
          'dailyLessonsByDate', 'screenLockBypassDateKey',
          'screenLockBypassUntilMs', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId.size() <= 128 && data.ownerId == userId && data.ownerId == request.auth.uid
        && data.pinHash is string && data.pinHash.size() <= 64
        && data.dailyScreenLimitMin is int && data.dailyScreenLimitMin >= 0 && data.dailyScreenLimitMin <= 480
        && data.quietHoursEnabled is bool
        && data.quietStart is string && data.quietStart.size() == 5 && data.quietStart.matches('^[0-2][0-9]:[0-5][0-9]$')
        && data.quietEnd is string && data.quietEnd.size() == 5 && data.quietEnd.matches('^[0-2][0-9]:[0-5][0-9]$')
        && data.strictAiFilter is bool
        && data.dailyMinutesByDate is map && data.dailyMinutesByDate.size() <= 14
        && data.dailyLessonsByDate is map && data.dailyLessonsByDate.size() <= 14
        && data.screenLockBypassDateKey is string && data.screenLockBypassDateKey.size() <= 10
        && (data.screenLockBypassDateKey == '' || data.screenLockBypassDateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && data.screenLockBypassUntilMs is int && data.screenLockBypassUntilMs >= 0 && data.screenLockBypassUntilMs <= 9999999999999
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserUpdateKeys() {
      return incoming().diff(existing()).affectedKeys().hasOnly([
        'petName', 'coins', 'level', 'xp',
        'stats', 'equipped', 'ownedItems', 'soundEnabled',
        'unlockedAchievements', 'progress', 'gameRecords', 'dailyRoutine',
        'updatedAt'
      ]);
    }

    function isLegacyUserDoc(data, userId) {
      return !('ownerId' in data)
        || !(data.ownerId is string)
        || data.ownerId != userId
        || !data.keys().hasOnly([
          'ownerId', 'petName', 'coins', 'level', 'xp',
          'stats', 'equipped', 'ownedItems', 'soundEnabled',
          'unlockedAchievements', 'progress', 'gameRecords', 'dailyRoutine',
          'createdAt', 'updatedAt'
        ])
        || !('createdAt' in data)
        || !(data.createdAt is timestamp)
        || !('updatedAt' in data)
        || !(data.updatedAt is timestamp)
        || !('petName' in data)
        || !('stats' in data)
        || !('equipped' in data)
        || !('soundEnabled' in data)
        || !('coins' in data)
        || !(data.coins is int)
        || !('level' in data)
        || !(data.level is int)
        || !('xp' in data)
        || !(data.xp is int)
        || !('ownedItems' in data)
        || !(data.ownedItems is list)
        || data.ownedItems.size() == 0
        || !('progress' in data)
        || !('gameRecords' in data)
        || !('dailyRoutine' in data)
        || !('unlockedAchievements' in data);
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserPetProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserPetProfile(incoming(), userId)
        && (!('ownerId' in existing()) || !(existing().ownerId is string) || existing().ownerId != userId || incoming().ownerId == existing().ownerId)
        && (!('createdAt' in existing()) || !(existing().createdAt is timestamp) || incoming().createdAt == existing().createdAt)
        && incoming().updatedAt == request.time
        && (
          isValidUserUpdateKeys()
          || isLegacyUserDoc(existing(), userId)
        );
      allow delete: if isValidId(userId) && isOwner(userId);

      match /private/{docId} {
        allow get: if isValidId(userId)
          && isValidId(docId)
          && (docId == 'info' || docId == 'profile' || docId == 'parental')
          && isOwner(userId);
        allow list: if false;
        allow create: if isValidId(userId)
          && isValidId(docId)
          && isOwner(userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && (
            (docId == 'info' && isValidPrivateInfo(incoming(), userId))
            || (docId == 'profile' && isValidUserHumanProfile(incoming(), userId))
            || (docId == 'parental' && isValidParentalConfig(incoming(), userId))
          );
        allow update: if isValidId(userId)
          && isValidId(docId)
          && isOwner(userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            (
              docId == 'info'
              && isValidPrivateInfo(incoming(), userId)
              && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'updatedAt'])
            )
            || (
              docId == 'profile'
              && isValidUserHumanProfile(incoming(), userId)
              && incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'birthDate', 'schooling', 'state', 'country', 'photoDataUrl', 'updatedAt'])
            )
            || (
              docId == 'parental'
              && isValidParentalConfig(incoming(), userId)
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'pinHash', 'dailyScreenLimitMin', 'quietHoursEnabled',
                'quietStart', 'quietEnd', 'strictAiFilter', 'dailyMinutesByDate',
                'dailyLessonsByDate', 'screenLockBypassDateKey',
                'screenLockBypassUntilMs', 'updatedAt'
              ])
            )
          );
        allow delete: if isValidId(userId)
          && isValidId(docId)
          && (docId == 'info' || docId == 'profile' || docId == 'parental')
          && isOwner(userId);
      }

      match /messages/{messageId} {
        allow get: if isValidId(userId)
          && isValidId(messageId)
          && isOwner(userId)
          && get(/databases/$(database)/documents/users/$(userId)).data.ownerId == request.auth.uid;
        allow list: if isValidId(userId)
          && isOwner(userId)
          && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(messageId)
          && isOwner(userId)
          && isValidChatMessage(incoming(), userId)
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.ownerId == request.auth.uid;
        allow update: if false;
        allow delete: if isValidId(userId)
          && isValidId(messageId)
          && isOwner(userId)
          && get(/databases/$(database)/documents/users/$(userId)).data.ownerId == request.auth.uid;
      }

      match /educationProgress/{trackId} {
        allow get: if isValidId(userId)
          && isValidId(trackId)
          && isValidEducationTrackId(trackId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.ownerId == request.auth.uid;
        allow list: if isValidId(userId)
          && isOwner(userId)
          && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(trackId)
          && isOwner(userId)
          && isValidEducationTrackProgress(incoming(), userId, trackId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.ownerId == request.auth.uid;
        allow update: if isValidId(userId)
          && isValidId(trackId)
          && isOwner(userId)
          && isValidEducationTrackProgress(incoming(), userId, trackId)
          && incoming().ownerId == existing().ownerId
          && incoming().trackId == existing().trackId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'completedUnits', 'unitBestStars', 'letterBestStars',
            'totalStars', 'streakDays', 'bestStreakDays', 'lastStudyDateKey',
            'masteredPrimary', 'masteredTargets', 'unlockedStickers',
            'freeExploreUnlocked', 'totalLessonsCompleted', 'dailyDateKey',
            'dailyStepsCount', 'dailyCompletedTargets', 'dailyBonusClaimedDateKey',
            'updatedAt'
          ])
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.ownerId == request.auth.uid;
        allow delete: if isValidId(userId)
          && isValidId(trackId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.ownerId == request.auth.uid;
      }

      match /economy/{docId} {
        allow get: if isValidId(userId)
          && isValidId(docId)
          && docId == 'daily'
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.ownerId == request.auth.uid;
        allow list: if false;
        allow create: if isValidId(userId)
          && isValidId(docId)
          && docId == 'daily'
          && isOwner(userId)
          && isValidDailyCoinEconomy(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.ownerId == request.auth.uid;
        allow update: if isValidId(userId)
          && isValidId(docId)
          && docId == 'daily'
          && isOwner(userId)
          && isValidDailyCoinEconomy(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'dateKey', 'petCoinsToday', 'lastPetCoinAtMs',
            'ballCoinsToday', 'lastBallCoinAtMs', 'minigameCoinsToday',
            'updatedAt'
          ])
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.ownerId == request.auth.uid;
        allow delete: if isValidId(userId)
          && isValidId(docId)
          && docId == 'daily'
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.ownerId == request.auth.uid;
      }
    }

    match /rankings/{userId} {
      allow get: if isValidId(userId) && isSignedIn();
      allow list: if isSignedIn();
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidRankingEntry(incoming(), userId)
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && incoming().ownerId == existing().ownerId
        && isValidRankingEntry(incoming(), userId)
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(userId) && isOwner(userId);
    }
  }
}
