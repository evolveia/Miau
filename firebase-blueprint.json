{
  "entities": {
    "UserPetProfile": {
      "title": "UserPetProfile",
      "description": "Stores the player's Miau virtual pet state, stats, currency, level, wardrobe customizations, minigame records, and daily routine.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "petName": {
          "type": "string",
          "description": "Display name of the virtual cat.",
          "minLength": 1,
          "maxLength": 32
        },
        "coins": {
          "type": "integer",
          "description": "Player coin balance."
        },
        "level": {
          "type": "integer",
          "description": "Current player level."
        },
        "xp": {
          "type": "integer",
          "description": "Current experience points toward next level."
        },
        "stats": {
          "type": "object",
          "description": "Essential pet status bars (hunger, hygiene, fun, sleep, happiness from 0 to 100)."
        },
        "equipped": {
          "type": "object",
          "description": "Currently equipped hat, accessory, and room background IDs."
        },
        "ownedItems": {
          "type": "array",
          "description": "List of owned customization item IDs (max 50)."
        },
        "soundEnabled": {
          "type": "boolean",
          "description": "Whether meow/purr/TTS sound effects are enabled."
        },
        "unlockedAchievements": {
          "type": "array",
          "description": "List of unlocked achievement IDs (max 50)."
        },
        "progress": {
          "type": "object",
          "description": "Action counters for achievements (mealsFed, gamesPlayed, cleanCount, petsCount, chatsCount)."
        },
        "gameRecords": {
          "type": "object",
          "description": "Per-minigame high scores, max stage reached, best time, and total coins."
        },
        "dailyRoutine": {
          "type": "object",
          "description": "Today's dateKey (YYYY-MM-DD) and completed routine slot IDs."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": [
        "ownerId",
        "petName",
        "coins",
        "level",
        "xp",
        "stats",
        "equipped",
        "ownedItems",
        "soundEnabled",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII storage for authenticated user email and display name.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 0,
          "maxLength": 80
        },
        "email": {
          "type": "string",
          "minLength": 0,
          "maxLength": 160
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "displayName", "email", "createdAt", "updatedAt"]
    },
    "UserHumanProfile": {
      "title": "UserHumanProfile",
      "description": "Isolated PII human user profile stored at /users/{userId}/private/profile.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fullName": {
          "type": "string",
          "minLength": 0,
          "maxLength": 100
        },
        "birthDate": {
          "type": "string",
          "minLength": 0,
          "maxLength": 10
        },
        "schooling": {
          "type": "string",
          "enum": ["", "educacao_infantil", "fundamental_1", "fundamental_2", "medio", "superior_outro"]
        },
        "state": {
          "type": "string",
          "minLength": 0,
          "maxLength": 60
        },
        "country": {
          "type": "string",
          "minLength": 0,
          "maxLength": 60
        },
        "photoDataUrl": {
          "type": "string",
          "minLength": 0,
          "maxLength": 180000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "fullName",
        "birthDate",
        "schooling",
        "state",
        "country",
        "photoDataUrl",
        "createdAt",
        "updatedAt"
      ]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "A conversation turn between the player and Miau.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sender": {
          "type": "string",
          "enum": ["user", "miau"]
        },
        "meowPrefix": {
          "type": "string",
          "minLength": 0,
          "maxLength": 40
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "mood": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "sender", "meowPrefix", "text", "mood", "createdAt"]
    },
    "RankingEntry": {
      "title": "RankingEntry",
      "description": "Public non-PII leaderboard summary per player for Miau minigames.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "playerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "petName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "schooling": {
          "type": "string",
          "enum": ["", "educacao_infantil", "fundamental_1", "fundamental_2", "medio", "superior_outro"],
          "description": "Optional schooling level segment for leaderboard filtering."
        },
        "totalScore": {
          "type": "integer"
        },
        "bestStage": {
          "type": "integer"
        },
        "coinsEarned": {
          "type": "integer"
        },
        "gameScores": {
          "type": "object",
          "description": "Optional per-minigame best scores (fish, memory, escape, galaxy, pacmiau, maze)."
        },
        "gameStages": {
          "type": "object",
          "description": "Optional per-minigame max stages reached (fish, memory, escape, galaxy, pacmiau, maze)."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "playerName", "petName", "totalScore", "bestStage", "coinsEarned", "updatedAt"]
    },
    "EducationTrackProgress": {
      "title": "EducationTrackProgress",
      "description": "Cloud-synced progress, stars, mastered targets, stickers, and daily goals for each educational track.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "trackId": {
          "type": "string",
          "enum": [
            "infantil_letras",
            "infantil_escrita",
            "infantil_escrita_consoantes",
            "infantil_consoantes",
            "infantil_cores_numeros",
            "infantil_soma_subtracao",
            "infantil_matematica_desafios",
            "infantil_natureza",
            "infantil_comidas_bebidas",
            "fund1_leitura",
            "fund1_matematica",
            "fund1_ciencias",
            "fund2_logica",
            "fund2_ciencias",
            "fund2_historia"
          ]
        },
        "completedUnits": { "type": "array" },
        "unitBestStars": { "type": "object" },
        "letterBestStars": { "type": "object" },
        "totalStars": { "type": "integer" },
        "streakDays": { "type": "integer" },
        "bestStreakDays": { "type": "integer" },
        "lastStudyDateKey": { "type": "string", "minLength": 0, "maxLength": 10 },
        "masteredPrimary": { "type": "array" },
        "masteredTargets": { "type": "array" },
        "unlockedStickers": { "type": "array" },
        "freeExploreUnlocked": { "type": "boolean" },
        "totalLessonsCompleted": { "type": "integer" },
        "dailyDateKey": { "type": "string", "minLength": 0, "maxLength": 10 },
        "dailyStepsCount": { "type": "integer" },
        "dailyCompletedTargets": { "type": "array" },
        "dailyBonusClaimedDateKey": { "type": "string", "minLength": 0, "maxLength": 10 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId",
        "trackId",
        "completedUnits",
        "unitBestStars",
        "letterBestStars",
        "totalStars",
        "streakDays",
        "bestStreakDays",
        "lastStudyDateKey",
        "masteredPrimary",
        "masteredTargets",
        "unlockedStickers",
        "freeExploreUnlocked",
        "totalLessonsCompleted",
        "dailyDateKey",
        "dailyStepsCount",
        "dailyCompletedTargets",
        "dailyBonusClaimedDateKey",
        "createdAt",
        "updatedAt"
      ]
    },
    "DailyCoinEconomy": {
      "title": "DailyCoinEconomy",
      "description": "Cloud-synced anti-farming daily coin caps and cooldown timestamps.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "dateKey": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "petCoinsToday": { "type": "integer" },
        "lastPetCoinAtMs": { "type": "integer" },
        "ballCoinsToday": { "type": "integer" },
        "lastBallCoinAtMs": { "type": "integer" },
        "minigameCoinsToday": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId",
        "dateKey",
        "petCoinsToday",
        "lastPetCoinAtMs",
        "ballCoinsToday",
        "lastBallCoinAtMs",
        "minigameCoinsToday",
        "createdAt",
        "updatedAt"
      ]
    },
    "ParentalControlConfig": {
      "title": "ParentalControlConfig",
      "description": "Cloud-synced parental controls, screen time limits, quiet hours, strict AI safety toggle, and 4-digit PIN hash at /users/{userId}/private/parental.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "pinHash": { "type": "string", "minLength": 0, "maxLength": 64 },
        "dailyScreenLimitMin": { "type": "integer" },
        "quietHoursEnabled": { "type": "boolean" },
        "quietStart": { "type": "string", "minLength": 5, "maxLength": 5 },
        "quietEnd": { "type": "string", "minLength": 5, "maxLength": 5 },
        "strictAiFilter": { "type": "boolean" },
        "dailyMinutesByDate": { "type": "object" },
        "dailyLessonsByDate": { "type": "object" },
        "screenLockBypassDateKey": { "type": "string", "minLength": 0, "maxLength": 10 },
        "screenLockBypassUntilMs": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId",
        "pinHash",
        "dailyScreenLimitMin",
        "quietHoursEnabled",
        "quietStart",
        "quietEnd",
        "strictAiFilter",
        "dailyMinutesByDate",
        "dailyLessonsByDate",
        "screenLockBypassDateKey",
        "screenLockBypassUntilMs",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPetProfile" },
      "description": "Player's virtual pet Miau profile, stats, coins, level, equipped items, game records, and daily routine."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Isolated private metadata (info, profile UserHumanProfile, and parental ParentalControlConfig) for the user."
    },
    "/users/{userId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Persisted chat messages with Miau."
    },
    "/users/{userId}/educationProgress/{trackId}": {
      "schema": { "$ref": "#/entities/EducationTrackProgress" },
      "description": "Cloud-synced progress per educational track for the user."
    },
    "/users/{userId}/economy/{docId}": {
      "schema": { "$ref": "#/entities/DailyCoinEconomy" },
      "description": "Cloud-synced daily anti-farming coin cap ledger (docId: daily)."
    },
    "/rankings/{userId}": {
      "schema": { "$ref": "#/entities/RankingEntry" },
      "description": "Non-PII minigame leaderboard entries."
    }
  }
}
